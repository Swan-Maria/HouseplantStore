@page "/"
@using Shared.Models
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject Services.ProductService ProductService
@inject Services.CartService CartService

<div style="display: grid; grid-template-columns: 240px 1fr; gap: 24px; width: 100%; align-items: start;">

    <aside style="position: sticky; top: 80px; max-height: calc(100vh - 104px); overflow-y: auto; padding-right: 4px;">

        <MudPaper Elevation="0" Square="true" Class="pa-4 d-flex flex-column" Style="background: transparent;">

            <MudText Typo="Typo.h5" Class="font-weight-bold mb-1">
                All Plants
            </MudText>

            <MudText Typo="Typo.body2"
                     Color="Color.Secondary"
                     Class="mb-6">

                @(_plants?.Count ?? 0) Plants Available

            </MudText>

            <!-- Categories -->

            <MudText Typo="Typo.subtitle2"
                     Class="font-weight-bold mb-2">

                Categories

            </MudText>

            <MudList T="int"
                     Dense="true"
                     Class="mb-4">

                <MudListItem OnClick="() => FilterByCategory(null)">
                    <div class="d-flex justify-space-between w-100">
                        <span>All Plants</span>
                        <span>@(_plants?.Count ?? 0)</span>
                    </div>
                </MudListItem>

                <MudListItem OnClick="() => FilterByCategory(PlantCategory.Foliage)">
                    <div class="d-flex justify-space-between w-100">
                        <span>Foliage</span>
                        <span>@(_plants?.Count(p => p.Category == PlantCategory.Foliage) ?? 0)</span>
                    </div>
                </MudListItem>

                <MudListItem OnClick="() => FilterByCategory(PlantCategory.Blooming)">
                    <div class="d-flex justify-space-between w-100">
                        <span>Blooming</span>
                        <span>@(_plants?.Count(p => p.Category == PlantCategory.Blooming) ?? 0)</span>
                    </div>
                </MudListItem>

                <MudListItem OnClick="() => FilterByCategory(PlantCategory.Succulents)">
                    <div class="d-flex justify-space-between w-100">
                        <span>Succulents</span>
                        <span>@(_plants?.Count(p => p.Category == PlantCategory.Succulents) ?? 0)</span>
                    </div>
                </MudListItem>

                <MudListItem OnClick="() => FilterByCategory(PlantCategory.LargeSize)">
                    <div class="d-flex justify-space-between w-100">
                        <span>Large Size</span>
                        <span>@(_plants?.Count(p => p.Category == PlantCategory.LargeSize) ?? 0)</span>
                    </div>
                </MudListItem>

            </MudList>

            <MudDivider Class="my-4" />

            <!-- Sorting -->

            <MudText Typo="Typo.subtitle2"
                     Class="font-weight-bold mb-2">

                Sort By

            </MudText>

            <MudSelect T="string"
                       Value="_sortOption"
                       ValueChanged="OnSortChanged"
                       Dense="true"
                       Variant="Variant.Outlined"
                       Class="mb-4">

                <MudSelectItem Value="@("price_asc")">
                    Price: Low to High
                </MudSelectItem>

                <MudSelectItem Value="@("price_desc")">
                    Price: High to Low
                </MudSelectItem>

                <MudSelectItem Value="@("care")">
                    Care Level
                </MudSelectItem>

            </MudSelect>

            <MudDivider Class="my-4" />

            <!-- Care Level -->

            <MudText Typo="Typo.subtitle2"
                     Class="font-weight-bold mb-2">

                Care Level

            </MudText>

            <MudCheckBox T="bool"
                         Value="@(_selectedCareLevel == 1)"
                         ValueChanged="@(x => FilterByCareLevel(x, 1))"
                         Label="Beginner Friendly"
                         Dense="true" />

            <MudCheckBox T="bool"
                         Value="@(_selectedCareLevel == 2)"
                         ValueChanged="@(x => FilterByCareLevel(x, 2))"
                         Label="Moderate"
                         Dense="true" />

            <MudCheckBox T="bool"
                         Value="@(_selectedCareLevel == 3)"
                         ValueChanged="@(x => FilterByCareLevel(x, 3))"
                         Label="Advanced"
                         Dense="true" />

            <!-- Price -->

            <MudText Typo="Typo.subtitle2"
                     Class="font-weight-bold mb-2">

                Max Price

            </MudText>

            <MudSlider T="decimal"
                       Min="10"
                       Max="200"
                       Value="@_maxPrice"
                       ValueChanged="OnPriceChanged"
                       Color="Color.Primary"
                       ValueLabel="true" />

            <div class="d-flex justify-space-between mt-1">
                <MudText Typo="Typo.caption">$10</MudText>
                <MudText Typo="Typo.caption">$100</MudText>
            </div>

        </MudPaper>

    </aside>

    <!-- Products -->

    <main style="width: 100%;">

        @if (_filteredPlants == null)
        {
            <MudText Typo="Typo.h6"
                     Class="text-center pa-8">

                Loading...

            </MudText>
        }
        else
        {
            <div style="
                display: grid;
                grid-template-columns: repeat(auto-fill, 250px);
                justify-content: space-between;
                gap: 24px;
                width: 100%;">

                @foreach (var plant in _filteredPlants)
                {
                    <div style="width: 250px;">

                        <MudCard Elevation="1"
                                 Class="d-flex flex-column justify-space-between"
                                 Style="
                                    height: 100%;
                                    border-radius: 24px;
                                    overflow: hidden;">

                            <MudCardContent Class="pa-3">

                                <!-- Image -->

                                <div style="
                                    background-color: rgba(0,0,0,0.03);
                                    border-radius: 18px;
                                    overflow: hidden;
                                    width: 100%;
                                    height: 280px;">
                                    
                                    <MudImage Src="@plant.ImageUrl"
                                              Alt="@plant.Name"
                                              ObjectFit="ObjectFit.Cover"
                                              Style="width: 100%; height: 100%; border-radius: 12px;" />



                                </div>

                                <!-- Name -->

                                <MudText Typo="Typo.body1" Class="font-weight-bold mt-4 text-truncate">
                                    @plant.Name
                                </MudText>

                                <!-- Price -->

                                <MudText Typo="Typo.body2"
                                         Color="Color.Primary"
                                         Class="font-weight-bold mt-1">

                                    @plant.Price.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))

                                </MudText>

                                <!-- Care -->

                                <div class="d-flex align-center mt-2 mb-2">

                                    <MudText Typo="Typo.caption"
                                             Class="me-2">

                                        Care Level:

                                    </MudText>

                                    @for (int i = 1; i <= 3; i++)
                                    {
                                        <MudIcon Icon="@(i <= plant.CareLevel
                                                           ? Icons.Material.Filled.WaterDrop
                                                           : Icons.Material.Outlined.WaterDrop)"
                                                 Size="Size.Small"
                                                 Color="Color.Primary"
                                                 Class="me-1" />
                                    }

                                </div>

                            </MudCardContent>

                            <!-- Button -->

                            <div class="pa-3 pt-0">

                                <MudButton FullWidth="true"
                                           Variant="@(GetPlantCount(plant.Id) > 0 ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Primary"
                                           Style="
                                                border-radius: 18px;
                                                height: 48px;"
                                           OnClick="() => AddToCart(plant)">

                                    @if (GetPlantCount(plant.Id) == 0)
                                    {
                                        <span>Add to Cart</span>
                                    }
                                    else
                                    {
                                        <span>Added (@GetPlantCount(plant.Id))</span>
                                    }

                                </MudButton>

                            </div>

                        </MudCard>

                    </div>
                }

            </div>
        }

    </main>

</div>

@code {

    private List<Plant>? _plants;
    private List<Plant>? _filteredPlants;

    private PlantCategory? _selectedCategory = null;

    private int? _selectedCareLevel = null;

    private decimal _maxPrice = 200;

    private string _sortOption = "price_asc";

    private Dictionary<int, int> _cartCounts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _plants = await ProductService.GetPlantsAsync();

            _filteredPlants = _plants.ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading plants: {ex.Message}");

            _plants = new List<Plant>();

            _filteredPlants = new List<Plant>();
        }
    }

    private void FilterByCategory(PlantCategory? category)
    {
        _selectedCategory = category;

        ApplyFilters();
    }

    private void FilterByCareLevel(bool value, int level)
    {
        if (value)
        {
            _selectedCareLevel = level;
        }
        else
        {
            _selectedCareLevel = null;
        }

        ApplyFilters();
    }

    private void OnPriceChanged(decimal value)
    {
        _maxPrice = value;

        ApplyFilters();
    }

    private void OnSortChanged(string value)
    {
        _sortOption = value;

        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (_plants == null)
            return;

        IEnumerable<Plant> query = _plants;

        // Category

        if (_selectedCategory != null)
        {
            query = query.Where(p => p.Category == _selectedCategory);
        }

        // Care Level

        if (_selectedCareLevel != null)
        {
            query = query.Where(p => p.CareLevel == _selectedCareLevel);
        }

        // Price

        query = query.Where(p => p.Price <= _maxPrice);

        // Sorting

        if (_sortOption == "price_desc")
        {
            query = query.OrderByDescending(p => p.Price);
        }
        else if (_sortOption == "care")
        {
            query = query.OrderBy(p => p.CareLevel);
        }
        else if (_sortOption == "category")
        {
            query = query.OrderBy(p => p.Category);
        }
        else
        {
            query = query.OrderBy(p => p.Price);
        }


        _filteredPlants = query.ToList();
    }

    private void AddToCart(Plant plant)
    {
        CartService.AddToCart(plant);

        if (_cartCounts.ContainsKey(plant.Id))
        {
            _cartCounts[plant.Id]++;
        }
        else
        {
            _cartCounts[plant.Id] = 1;
        }
    }

    private int GetPlantCount(int plantId)
    {
        return _cartCounts.ContainsKey(plantId)
            ? _cartCounts[plantId]
            : 0;
    }
}