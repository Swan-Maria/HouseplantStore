@page "/"
@using Shared.Models
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject Services.ProductService ProductService
@inject Services.CartService CartService

<div style="display: grid; grid-template-columns: 240px 1fr; gap: 24px; width: 100%; align-items: start;">

    <aside style="position: sticky; top: 80px; max-height: calc(100vh - 104px); overflow-y: auto; padding-right: 4px;">
        <MudPaper Class="pa-4" Elevation="0" Style="background: transparent;">

            <!-- TITLE -->
            <MudText Typo="Typo.h1" Class="font-weight-bold mb-1">
                All Plants
            </MudText>

            <MudText Typo="Typo.body2" Class="mb-2">
                @_plants?.Count() Plants Available
            </MudText>
            
            <!-- CATEGORIES -->
            <MudText Typo="Typo.h5" Class="font-weight-bold mt-3 mb-2">
                Categories
            </MudText>

            <MudList T="PlantCategory?" Dense="true" Class="mb-4">

                <MudListItem T="PlantCategory?" Value="null"
                             OnClick="() => FilterByCategory(null)">
                    <div class="d-flex justify-space-between align-center w-100">
                        <MudText Typo="Typo.h6">All Plants</MudText>
                        <MudText Typo="Typo.h6">@(_plants?.Count ?? 0)</MudText>
                    </div>
                </MudListItem>

                @foreach (PlantCategory cat in Enum.GetValues(typeof(PlantCategory)))
                {
                    <MudListItem T="PlantCategory?" Value="cat"
                                 OnClick="() => FilterByCategory(cat)">
                        <div class="d-flex justify-space-between align-center w-100">
                            <MudText Typo="Typo.h6">@cat</MudText>
                            <MudText Typo="Typo.h6">@(_plants?.Count(p => p.Category == cat) ?? 0)</MudText>
                        </div>
                    </MudListItem>
                }

            </MudList>

            <MudDivider Class="my-4" />

            <!-- CARE LEVEL -->
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-2">
                Care Level
            </MudText>

            <MudCheckBox T="bool" 
                         Value="@(_selectedCareLevel == 1)" 
                         ValueChanged="v => FilterByCareLevel(v, 1)"
                         Color="Color.Primary">
                <LabelContent>
                    <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold">
                        Beginner
                    </MudText>
                </LabelContent>
            </MudCheckBox>

            <MudCheckBox T="bool" 
                         Value="@(_selectedCareLevel == 2)" 
                         ValueChanged="v => FilterByCareLevel(v, 2)"
                         Color="Color.Primary">
                <LabelContent>
                    <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold">
                        Moderate
                    </MudText>
                </LabelContent>
            </MudCheckBox>
            
            <MudCheckBox T="bool" 
                         Value="@(_selectedCareLevel == 3)" 
                         ValueChanged="v => FilterByCareLevel(v, 3)"
                         Color="Color.Primary">
                <LabelContent>
                    <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold">
                        Advanced
                    </MudText>
                </LabelContent>
            </MudCheckBox>
            
            <MudDivider Class="my-4" />

            <!--  PET FRIENDLY  -->
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-2">
                Pet Friendly
            </MudText>

            <MudSwitch T="bool?"
                       Value="_isPetFriendly"
                       ValueChanged="OnPetFriendlyChanged"
                       Color="Color.Primary"
                       Class="mt-2">
                <ChildContent>
                    <MudText Typo="Typo.h6">Pet Friendly</MudText>
                </ChildContent>
            </MudSwitch>

            <MudDivider Class="my-4" />

            <!--  PRICE  -->
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-2">
                Max Price
            </MudText>

            <MudSlider T="decimal"
                       Min="8"
                       Max="90"
                       Value="@_maxPrice"
                       ValueChanged="OnPriceChanged"
                       Color="Color.Primary"
                       ValueLabel="true" />

            <div class="d-flex justify-space-between mt-1">
                <MudText Typo="Typo.h6">$8</MudText>
                <MudText Typo="Typo.h6">$90</MudText>
            </div>

        </MudPaper>
    </aside>

    <!-- Products -->

    <main style="width: 100%;">

        @if (_filteredPlants == null)
        {
            <MudText Typo="Typo.h4" Class="text-center pa-8">
                Loading...
            </MudText>
        }
        else
        {
            <div style="
                display: grid;
                grid-template-columns: repeat(auto-fill, 250px);
                justify-content: space-between;
                gap: 24px;
                width: 100%;">

                @foreach (var plant in _filteredPlants)
                {
                    <div style="width: 250px;">

                        <MudCard Elevation="1"
                                 Class="d-flex flex-column justify-space-between"
                                 Style="
                                    height: 100%;
                                    border-radius: 24px;
                                    overflow: hidden;">

                            <MudCardContent Class="pa-3 pb-0">

                                <!-- Image -->

                                <div style="
                                    background-color: rgba(0,0,0,0.03);
                                    border-radius: 18px;
                                    overflow: hidden;
                                    width: 100%;
                                    height: 280px;">
                                    <MudImage Src="@plant.ImageUrl"
                                              Alt="@plant.Name"
                                              ObjectFit="ObjectFit.Cover"
                                              Style="width: 100%; height: 100%; border-radius: 12px;" />
                                </div>

                                <!-- Name -->
                                <MudText Typo="Typo.h5" Class="font-weight-bold mt-4 text-truncate">
                                    @plant.Name
                                </MudText>

                                <!-- Price -->
                                <MudText Typo="Typo.h6"
                                         Color="Color.Dark"
                                         Class="font-weight-bold mt-1">

                                    @plant.Price.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))

                                </MudText>

                                <!-- Light requirement -->
                                <div class="d-flex align-center mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.WbSunny"
                                             Color="Color.Warning"
                                             Size="Size.Small" Class="me-1" />

                                    @for (int i = 1; i < 3; i++)
                                    {
                                        <MudIcon Icon="@(i <= (int)plant.Light
                                                           ? Icons.Material.Filled.WbSunny
                                                           : Icons.Material.Outlined.WbSunny)"
                                                 Size="Size.Small"
                                                 Color="Color.Warning"
                                                 Class="me-1" />
                                    }
                                </div>
                                
                                <!-- Watering -->
                                <div class="d-flex align-center">

                                    <MudIcon Icon="@Icons.Material.Filled.WaterDrop"
                                             Color="Color.Info"
                                             Size="Size.Small"
                                             Class="me-1" />

                                    @for (int i = 1; i < 3; i++)
                                    {
                                        <MudIcon Icon="@(i <= (int)plant.Watering
                                                           ? Icons.Material.Filled.WaterDrop
                                                           : Icons.Material.Outlined.WaterDrop)"
                                                 Size="Size.Small"
                                                 Color="Color.Info"
                                                 Class="me-1" />
                                    }
                                </div>

                            </MudCardContent>

                            <!-- Button -->

                            <div class="pa-3 pt-0">

                                <MudButton FullWidth="true"
                                           Variant="@(GetPlantCount(plant.Id) > 0 ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Primary"
                                           Style="
                                                border-radius: 18px;
                                                height: 48px;"
                                           OnClick="() => AddToCart(plant)">

                                    @if (GetPlantCount(plant.Id) == 0)
                                    {
                                        <span>Add to Cart</span>
                                    }
                                    else
                                    {
                                        <span>Added (@GetPlantCount(plant.Id))</span>
                                    }

                                </MudButton>

                            </div>

                        </MudCard>

                    </div>
                }

            </div>
        }

    </main>

</div>
